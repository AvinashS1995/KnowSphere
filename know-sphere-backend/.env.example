# ─────────────────────────────────────────────────────────────────────────────
# KnowSphere Backend – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_DB_LOCAL_URL=mongodb://localhost:27017/ai_system

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── AWS / Filebase S3-compatible ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT=https://s3.filebase.com

# ── AI Provider API Keys (never expose these to the frontend) ─────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Active AI Provider (admin can change via Settings UI) ────────────────────
# These are defaults only; the Settings UI writes to MongoDB and overrides them.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge-base

# ── Redis / BullMQ ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Document Processing ───────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
